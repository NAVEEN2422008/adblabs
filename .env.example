# ADB LABS — Environment Configuration Template
# Copy this file to .env.local for local development. NEVER commit real secret keys.

# Production Domain & API
VITE_SITE_URL=https://adblabs.in
VITE_API_BASE_URL=https://api.adblabs.in

# Smart Enquiry Backend Integration (Supabase / Postgres / Custom API)
VITE_ENQUIRY_API_ENDPOINT=https://api.adblabs.in/v1/enquiries
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Transactional Email Alerts (Resend / Postmark / SendGrid)
RESEND_API_KEY=re_your_api_key_here
ADMIN_NOTIFICATION_EMAIL=engineering@adblabs.in
CLIENT_CONFIRMATION_SENDER=no-reply@adblabs.in

# Deployment & Analytics (Optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NETLIFY_SITE_ID=2cfbf5e2-d3a1-4177-b95c-223b44f17846
